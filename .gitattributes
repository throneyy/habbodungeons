
# Pin known line-ending conventions for files that have previously been
# flipped by editors/tools with different defaults, so autocrlf/tool churn
# can't silently rewrite an entire file's line endings again.
css/habbo-ui.css text eol=crlf
js/dailyRewardDock.js text eol=lf
# GENERATED by tools/gen-furni-dims.mjs, which emits LF. Its --check mode (and
# tests/furniLogic.test.js behind it) compares the generated text to the file on
# disk with a raw `prev !== text`, so a CRLF checkout under core.autocrlf=true
# reports DRIFT on every line of a file nobody touched.
js/furniDims.js text eol=lf
# Shell scripts must stay LF: a CRLF checkout under core.autocrlf=true makes
# bash fail on the shebang with $'\r': command not found. Generic across
# reference sets, matching the .gitignore rules for the same paths.
tools/reference/**/*.sh text eol=lf
